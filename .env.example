# RepoSurgeon environment template.
#
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# Every secret below is rejected at startup by the affected process when unset
# outside the test environment.

# --- Shared -----------------------------------------------------------------
# development | test | production
RS_ENV=development
RS_LOG_LEVEL=info
RS_LOG_FORMAT=json
RS_VERSION=0.1.0

# --- PostgreSQL -------------------------------------------------------------
# Local development keeps the same credentials as the compose service.
POSTGRES_USER=reposurgeon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reposurgeon
# Host value used by the Go processes inside compose:
RS_DATABASE_URL=postgres://reposurgeon:change-me@postgres:5432/reposurgeon?sslmode=disable
# Host value used by `make test` / local tooling against a local server:
# RS_TEST_DATABASE_URL=postgres://reposurgeon@127.0.0.1:5432/reposurgeon_test?sslmode=disable

# --- API --------------------------------------------------------------------
RS_HTTP_ADDR=:8080
RS_MIGRATIONS_DIR=migrations
RS_MIGRATE_ON_START=true
RS_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Worker -----------------------------------------------------------------
RS_WORKER_ADDR=:8081

# --- Isolated runner --------------------------------------------------------
# Shared secret between callers and the runner service. Generate with:
#   openssl rand -hex 32
RS_RUNNER_TOKEN=generate-a-256-bit-secret
RS_RUNNER_ADDR=127.0.0.1:8091
RS_RUNNER_WORKSPACE_ROOT=./workspaces
# Comma-separated absolute programs the runner may execute. Empty denies all.
RS_RUNNER_ALLOWED_PROGRAMS=/bin/echo,/usr/bin/seq
# Forwarded to child processes; runner secrets are never in this list.
RS_RUNNER_ENV_ALLOWLIST=PATH,LANG,LC_ALL,TZ
RS_RUNNER_MAX_TIMEOUT_MS=60000
RS_RUNNER_MAX_OUTPUT_BYTES=65536

# --- Credential encryption (required; envelope AEAD) -----------------------
# 256-bit key that wraps provider credentials, base64 encoded. Generate:
#   openssl rand -base64 32
RS_CREDENTIAL_KEK=generate-a-256-bit-key
RS_CREDENTIAL_KEY_VERSION=1

# --- Model provider (required from M03 onward) ------------------------------
# StepFun first-party endpoint and default model. Optional in M00/M01/M02;
# the model gateway rejects a missing key when it is first used.
# STEPFUN_API_KEY=
# STEPFUN_BASE_URL=https://api.stepfun.ai/v1
# DEFAULT_MODEL_ID=step-5-preview

# --- GitHub (required from M04 onward) --------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=
