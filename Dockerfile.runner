# syntax=docker/dockerfile:1

# Isolated execution trust boundary (docs/adr/ADR-001). This image is
# deliberately different from the API/worker images:
#   * non-root user only, refuses to start as root
#   * no repository credentials, no database DSN, no model provider key
#   * attached to an internal (no egress) network in docker-compose
#   * read-only root filesystem, all capabilities dropped, no new privileges
# It runs allowlisted programs inside a confined workspace directory only.
FROM golang:1.26.10-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/runner ./cmd/runner

FROM debian:12-slim AS runtime

# coreutils provides the executables the runner allowlist may reference; curl
# powers the container healthcheck. No shell access is granted to callers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends coreutils ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin runner

COPY --from=build --chown=10001:10001 /out/runner /app/runner

USER 10001:10001
WORKDIR /app
ENV RS_RUNNER_ADDR=:8091 \
    RS_RUNNER_WORKSPACE_ROOT=/app/workspaces \
    RS_LOG_FORMAT=json

EXPOSE 8091
VOLUME ["/app/workspaces"]
ENTRYPOINT ["/app/runner"]
